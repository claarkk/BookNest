{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build BookNest",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "LibraryManagement.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run BookNest",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        ".\\LibraryManagement.csproj"
      ],
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
